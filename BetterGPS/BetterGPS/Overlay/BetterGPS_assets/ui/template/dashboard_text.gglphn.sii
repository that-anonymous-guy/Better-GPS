SiiNunit
{
# For modders: Please do not modify this file if you want to add a new entry. Create in
# this directory a new file "<base_name>.<idofyourmod>.sii" where <base_name> is name of
# base file without the extension (e.g. "dashboard" for "/ui/template/dashboard.sii") and <idofyourmod> is
# some string which is unlikely to conflict with other mod.
#
# Warning: Even if the units are specified in more than one source file, they share the
# same namespace so suffixes or prefixes should be used to avoid conflicts.

ui::text_template : txt.gglphnclk {
	name: "zDB Google Phone Clock"
	text: "<align vstyle=center hstyle=center><font face=/font/db_normal.font xscale=1.164 yscale=1.164><color value=ff636161>%0</font></align>"
}

ui::text_template : txt.gglphnspdl {
	name: "zDB Google Phone Speed Limit"
	text: "<img src=/material/ui/adviser/limit_sign.mat xscale=stretch yscale=stretch><ret><align hstyle=center vstyle=center><font face=/font/normal.font xscale=2.25 yscale=2.34><color value=@@clr_black@@>%0</font></align>"
}

ui::text_template : txt.gglphneta {
	name: "zDB Google Phone ETA"
	text: "<color value=ff636161><align hstyle=left vstyle=center><font face=/font/db_normal.font xscale=1.45 yscale=1.45>- %0</font></align>"
}

ui::text_template : txt.gglphncmpss {
	name: "zDB Google Phone CPS"
	text: "<color value=FFFFFFFF><align vstyle=center hstyle=center><font face=/font/db_normal.font xscale=1.75 yscale=1.75>Heading Toward %0</font></align>"
}

}
