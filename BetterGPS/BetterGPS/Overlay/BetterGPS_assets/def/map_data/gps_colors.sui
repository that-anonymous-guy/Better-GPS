# Route palette: Google Maps blue RGB #4285F4; SCS packed colors use ABGR.
	prefab_color:				0xFFE0D8D0	# Undiscovered prefab driveable areas
	prefab_obstacle_color:			0xFFE0D8D0	# Undiscovered prefab buildings
	prefab_grass_color:			0xFFE0D8D0	# Undiscovered prefab grass areas
	prefab_discovered_color:		0xFFE1E1E1	# Discovered prefab driveable areas
	prefab_obstacle_discovered_color:	0xFFBEBEBE	# Discovered prefab buildings
	prefab_grass_discovered_color:		0xFFB4EAC9	# Discovered prefab grass

	outline_color:			0xFFA64E17	# Route outline
	navigation_color:		0xFFF48542	# Navigation path color
	navigation_current_color:	0xFFF48542	# ATS 1.61 current navigation path, Google Maps RGB #4285F4
	navigation_highlight_color:	0xFFF48542	# Navigation path color, highligted segment
	navigation_fade_color:		0x50F48542	# Navigation path color, faded segment
	navigation_arrow_color: 	0x0006FB11	# Navigation crossroad arrows color
